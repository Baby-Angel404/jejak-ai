# Contoh nginx di depan Express. Bedanya dengan Caddy: nginx tidak mengurus sertifikat,
# jadi TLS diurus terpisah (certbot atau sertifikat internal Anda).
#
#   nginx -c "$PWD/deploy/nginx.conf.example"   # sesuaikan path & certifikat dulu
#
# Dua hal yang wajib benar untuk aplikasi ini:
#   1. proxy_buffering off  -> kalau tidak, SSE (/api/chat) ditahan sampai prompt selesai
#   2. X-Forwarded-For      -> Express dijalankan dengan TRUST_PROXY=1

server {
    listen 443 ssl http2;
    server_name jejak-ai.example.com;

    ssl_certificate     /etc/letsencrypt/live/jejak-ai.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jejak-ai.example.com/privkey.pem;

    # Batas badan permintaan: prompt tidak perlu sebesar ini.
    client_max_body_size 2m;

    location / {
        proxy_pass         http://127.0.0.1:8787;
        proxy_http_version 1.1;

        # SSE: jangan buffer dan jangan kompres secara bertahap
        proxy_buffering    off;
        proxy_cache        off;
        proxy_set_header   Connection "";

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Timeout panjang: satu prompt bisa streaming lama.
        proxy_read_timeout 600s;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}

server {
    listen 80;
    server_name jejak-ai.example.com;
    return 301 https://$host$request_uri;
}

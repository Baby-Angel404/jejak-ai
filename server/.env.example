PORT=8787
# Asal frontend yang boleh memanggil API ini (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Isi hanya provider yang kamu pakai. Key TIDAK PERNAH dikirim ke browser.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Provider custom (endpoint OpenAI-compatible, mis. Ollama, vLLM, LM Studio)
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=llama3.1

# Opsional: timpa nama model per provider, mis. OPENAI_MODEL=gpt-4o-mini

# Bawaan hanya localhost. Mengubah ke 0.0.0.0 membuat server bisa dijangkau jaringan lain;
# setiap /api/chat memakai API key Anda, jadi server akan memberi peringatan.
#HOST=127.0.0.1

# Batas laju untuk endpoint yang memakai API key: permintaan per menit per IP. 0 = tanpa batas.
#RATE_LIMIT=30

# Token opsional untuk deployment bersama. Kalau diisi, /api/chat, /api/compare, dan
# perubahan koefisien menuntut header `x-jejak-token`. Sengaja tidak dikirim dari browser:
# token yang ada di bundle frontend bukan rahasia lagi (biasanya proxy yang menyisipkannya).
#AUTH_TOKEN=

# Di belakang reverse proxy, Express hanya memakai X-Forwarded-For kalau ini diaktifkan.
# Tanpa itu semua permintaan terlihat berasal dari alamat proxy, sehingga rate limit
# (@RATE_LIMIT) jadi satu kubus bersama untuk semua pengguna.
#TRUST_PROXY=1

# Contoh di deploy/Caddyfile dan deploy/nginx.conf.example. Yang wajib: buffering
# dimatikan agar SSE /api/chat tidak ditahan sampai prompt selesai.
